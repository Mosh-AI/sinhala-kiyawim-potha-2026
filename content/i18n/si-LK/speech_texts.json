{
  "pg007_im001": "ගසක පොළොව යට මුල් ඇත. මුල්වලට ඉහළින් කඳ ඇත. කඳෙන් අතු පැතිරී ඇත. අතුවල කොළ රාශියක් ඇත.",
  "pg007_n0001": "ගස",
  "pg008_im004": "ඉහළින් කඳු අතරින් ගඟක් ගලා එයි. ගඟ දෙපස තණකොළ සහ පඳුරු ඇත. පහළින් මලක් ඇත. එයට විශාල පෙති රාශියක් සහ මැද කොටසක් ඇත. මලේ පෙති වටා විහිදී ඇත.",
  "pg008_im004_seg001_v1_crop_v1": "කඳු අතරින් ගඟක් ගලා එයි. ගඟ දෙපස තණකොළ සහ පඳුරු ඇත.",
  "pg008_im004_seg002_v1": "මලක් ඇත. එයට විශාල පෙති රාශියක් සහ මැද කොටසක් ඇත. මලේ පෙති වටා විහිදී ඇත.",
  "pg008_n0002": "ගඟ",
  "pg008_n0004": "මල",
  "pg009_im001": "කඳු අතරින් ගඟක් ගලා එයි. ගඟ දෙපස තණකොළ සහ පඳුරු ඇත. ගඟට වම් පසින් ගසක් ඇත. පොළොවට යටින් ගසේ මුල් ඇත. මුල්වලට ඉහළින් කඳ ඇත. කඳෙන් අතු පැතිරී ඇත. අතුවල කොළ රාශියක් ඇත. ගස යට රතු පාට මලක් ඇත.",
  "pg009_n0002": "ගඟ ළඟ ගස",
  "pg009_n0003": "ගස යට මල",
  "pg010_im002": "යහළුවන් තෙදෙනෙක් හොඳින් වැඩුණු ලොකු රතු මල් ගස දෙස බලා සිටී.",
  "pg010_n0002": "ගගන නයන",
  "pg010_n0003": "අර බලන්න.",
  "pg011_im001": "තණකොළ මැද හොඳින් වැඩුණු මල් පිපුණු ගසක් ඇත. ගසේ ඉහළ සහ පහළ මල් පිපී ඇත. ගස වටා සමනලුන් පියාඹයි. බිමද මල් වැටී ඇත.",
  "pg011_n0002": "ගස වට කර මල්",
  "pg011_n0003": "ඉහළ පහළ මල්",
  "pg012_im002": "මල්වත්තක සිටින සාරදා සහ සරලා මල් දෙස බලා සිටී.",
  "pg012_n0002": "මල්",
  "pg012_n0004": "පාට පාට මල්",
  "pg012_n0005": "හරි ලස්සන මල්",
  "pg012_n0006": "සරලා මල් බලන්න ආවා.",
  "pg012_n0007": "සාරදාත් ආවා.",
  "pg013_im001": "මල්වත්තක සිටින සාරදා සහ සරලා මලක් උඩ සිටින සමනලයෙක් දෙස බලා සිටී.",
  "pg013_n0004": "අර බලන්න සාරදා",
  "pg013_n0005": "ලස්සන සමනලයෙක්",
  "pg013_n0006": "සරලා කිව්වා.",
  "pg013_n0008": "සමනලයා මල උඩ",
  "pg013_n0009": "මලක් උඩ තවත් මලක්",
  "pg013_n0010": "සාරදා කිව්වා.",
  "pg014_im002": "රෝස පාට ලොකු මලක් උඩ ලස්සන සමනලයෙක් සිටියි. ඒ මල වටා තවත් ලස්සන මල් ඇත.",
  "pg014_n0003": "මහ පුදුමෙකි",
  "pg014_n0005": "මලෙක මලෙකි",
  "pg014_n0006": "නැහැ එහි සකි",
  "pg014_n0007": "සමනලයෙකි",
  "pg014_n0008": "කුමාරතුංග මුනිදාස මහතා",
  "pg015_im001": "හාවෙක් අඹ ගස යට සිටී. ගගන, කලණ, සරලා සහ සාරදා හාවා දෙස බලමින් එති. ඔවුන් පිටුපස නිවාස දෙකක් ඇත.",
  "pg015_n0002": "හාවා සහ යහළුවෝ",
  "pg015_n0004": "හාවා අඹ ගස යටට ආවා.",
  "pg015_n0005": "ගගන හාවා දැක්කා.",
  "pg015_n0006": "සරලා එන්න.",
  "pg015_n0007": "කලණ එන්න.",
  "pg015_n0008": "සාරදාත් එන්න.",
  "pg015_n0009": "හාවා බලන්න එන්න.",
  "pg016_im002": "ගගන, කලණ, සරලා සහ සාරදා තණබිමේ සිටිති. ඔවුන් ඈත ගස යට සිටින හාවා දෙස බලති.",
  "pg016_n0002": "සරලා ආවා.",
  "pg016_n0003": "කලණත් සාරදාත් ආවා.",
  "pg016_n0004": "අන්න හාවා",
  "pg016_n0005": "මම හාවා ළඟට යන්න ද?",
  "pg016_n0006": "කලණ ඇසුවා.",
  "pg016_n0007": "හාවා බය වෙයි",
  "pg016_n0008": "අපි ඈත ඉඳන් බලමු",
  "pg016_n0009": "ගගන කිවුවා.",
  "pg017_im001": "ගඟ අයිනේ තණකොළ මත හාවෙක් දෙපයින් සිටගෙන සිටී. පිටුපසින් ගසක් සහ ගඟේ වතුර ඇත.",
  "pg017_n0002": "හාවාගේ වග",
  "pg017_n0004": "හා හා හරි හාවා",
  "pg017_n0005": "කැලේ මැදින් ආවා",
  "pg017_n0006": "හිටගෙන ගඟ ගාවා",
  "pg017_n0007": "වටපිට ඇහැ ලෑවා",
  "pg017_n0008": "කොළ දෙක තුනක් කෑවා",
  "pg017_n0009": "පැන් උගුරක් බීවා",
  "pg017_n0010": "තොල කට ලෙව කෑවා",
  "pg017_n0011": "ඉතින් ඇතැයි කීවා",
  "pg018_im002": "තණබිමේ හාවෝ තුන්දෙනෙක් සිටිති. එක් හාවෙක් වීණාවක් වයයි. එක් හාවෙක් නටයි. එක් හාවෙක් බිම වැතිර සිටී.",
  "pg018_n0003": "තබා නිකට ගාවා",
  "pg018_n0004": "වීණාවක් ගෑවා",
  "pg018_n0005": "මිහිරි සින්දු කීවා",
  "pg018_n0006": "නැටුම් ටිකක් පෑවා",
  "pg018_n0007": "එයින් වෙහෙස වූවා",
  "pg018_n0008": "ඉඳගෙන හති ලෑවා",
  "pg018_n0009": "තණබිස්සේ බාවා",
  "pg018_n0010": "ඇඟ පත සැතැපූවා",
  "pg018_n0011": "කුමාරතුංග මුනිදාස මහතා",
  "pg019_im001": "නයන ඇඳේ වාඩි වී සිටී. ඔහු කවුළුවෙන් පායන හිරු දෙස බලයි. කවුළුවෙන් පිටත අත්තක කහ පාට කුරුල්ලෝ දෙදෙනෙක් සිටිති.",
  "pg019_n0002": "උපන් දිනය",
  "pg019_n0004": "අද නයනගේ උපන් දිනයයි.",
  "pg019_n0005": "නයන උදෙන්ම අවදි වුණා.",
  "pg019_n0006": "දත් මැද්දා.",
  "pg019_n0007": "මුහුණ සේදුවා.",
  "pg020_im002": "සාලයේ නයනගේ අම්මා, තාත්තා, අක්කා සහ යහළුවෝ සිටිති. යහළුවෝ දෙදෙනෙක් තෑගි අතින් ගෙන සිටිති. මේසය මත තෑගි පෙට්ටියක් ඇත.",
  "pg020_im002_crop_v1": "සාලයේ නයනගේ අම්මා, තාත්තා, අක්කා සහ යහළුවෝ සිටිති. යහළුවෝ දෙදෙනෙක් තෑගි අතින් ගෙන සිටිති. මේසය මත තෑගි පෙට්ටියක් ඇත.",
  "pg020_n0002": "නයන සාලයට ආවා.",
  "pg020_n0003": "නයනගේ යහළුවොත් ආවා.",
  "pg020_n0005": "අම්මයි තාත්තයි අක්කයි සාලයට ආවා.",
  "pg020_n0007": "සුබ උපන් දිනයක් වේවා!",
  "pg020_n0008": "හැම දෙනාම නයනට සුබ පැතුවා.",
  "pg020_n0009": "බොහොම ස්තුතියි",
  "pg020_n0010": "නයන කිවුවා.",
  "pg021_im001": "නයනගේ පවුලේ අය සහ යහළුවෝ කෑම මේසය වටා සිටිති. අම්මා බඳුනකින් කිරිබත් බෙදයි. මේසය මත පිඟන් සහ කෙසෙල් ගෙඩි ඇත.",
  "pg021_im001_crop_v1": "නයනගේ පවුලේ අය සහ යහළුවෝ කෑම මේසය වටා සිටිති. අම්මා බඳුනකින් කිරිබත් බෙදයි. මේසය මත පිඟන් සහ කෙසෙල් ගෙඩි ඇත.",
  "pg021_n0002": "හැම දෙනාම කිරිබත් කෑවා.",
  "pg021_n0003": "තේ පානය කළා.",
  "pg021_n0005": "යහළුවන් රැගෙන ආ තෑගි නයනට දුන්නා.",
  "pg021_n0006": "ස්තුති කරමින් නයන තෑගි ගත්තා.",
  "pg022_im002": "තාත්තා නයනට රඹුටන් පැළයක් දෙයි. පැළය කළු උරයක ඇත. ඔවුන් පිටුපස ගස් ඇත.",
  "pg022_n0002": "පුතේ, මේ රඹුටන් පැළය ඔයාට",
  "pg022_n0003": "මේක අපි වත්ත පහළ සිටවමු",
  "pg022_n0004": "තාත්තා කිවුවා.",
  "pg022_n0006": "මේ තමයි",
  "pg022_n0007": "අපි පුතාට දෙන උපන් දින තෑග්ග",
  "pg022_n0008": "අම්මා කිවුවා.",
  "pg023_im001": "නයන වළක් අසල දණගසා සිටී. ඔහු අතේ රඹුටන් පැළයක් ඇත. බිම උදැල්ලක් සහ කුඩා උදැල්ලක් ඇත.",
  "pg023_n0002": "නයන රඹුටන් පැළය සිටවුවා.",
  "pg023_n0003": "මම මේ පැළය හොඳට රැක බලා ගන්නවා, නයන කිවුවා.",
  "pg023_n0005": "උපන් දිනය දවසේ නයන ගොඩක් සතුටු වුණා.",
  "pg024_im002": "පන්තියේ ළමයි කිහිප දෙනෙක් අත් එක් කර ගුරුතුමියට ආයුබෝවන් කියති. ගුරුතුමියත් අත් එක් කර සිටී.",
  "pg024_n0002": "සතුන්ට ආදරෙයි.",
  "pg024_n0004": "ගුරුතුමිය පන්තියට ආවා.",
  "pg024_n0005": "ආයුබෝවන්! ගුරුතුමී.",
  "pg024_n0006": "ආයුබෝවන්! දුවේ, පුතේ.",
  "pg024_n0007": "මගේ පුංචි දුවලා පුතාලා.",
  "pg024_n0008": "සතුන්ට ගොඩක් ආදරෙයි නේද?",
  "pg024_n0009": "ඔව්, ගුරුතුමී.",
  "pg024_n0010": "අපි සතුන්ට ගොඩක් ආදරෙයි.",
  "pg025_im001": "පාසල් ඇඳුමෙන් සිටින ගගන කතා කරයි. ඔහුගේ සිතුවිල්ලේ ළමයෙක් බල්ලෙකුට කෑම දෙයි.",
  "pg025_n0002": "සතුන්ට ආදරයෙන් සලකන්නේ කොහොම ද?",
  "pg025_n0003": "ගුරුතුමී ඇසුවා.",
  "pg025_n0004": "සතුන්ට හිරිහැර කරන්න හොඳ නෑ.",
  "pg025_n0005": "සතුන්ට කෑම බීම දෙන්න ඕනෑ.",
  "pg025_n0006": "ගගන කිවුවා.",
  "pg025_n0007": "බොහොම හොඳයි, ගගන.",
  "pg025_n0008": "ගුරුතුමී කිවුවා.",
  "pg026_im002": "ගුරුතුමිය පන්තියේ සිටී. ළමයි බොහෝ දෙනෙක් අත් ඔසවා සිටිති.",
  "pg026_im002_crop_v1": "ගුරුතුමිය පන්තියේ සිටී. ළමයි බොහෝ දෙනෙක් අත් ඔසවා සිටිති.",
  "pg026_n0002": "සතුන්ට ආදරයෙන් සලකන",
  "pg026_n0003": "දුවලා පුතාලා, අත් ඔසවන්න.",
  "pg026_n0004": "ගුරුතුමී කිවුවා.",
  "pg026_n0005": "සියලු දෙනාම අත් එසවූවා.",
  "pg026_n0006": "බොහොම හොඳයි.",
  "pg026_n0007": "හැමෝම සතුන්ට ආදරයෙන් සලකනවා.",
  "pg026_n0008": "එහෙනම් දැන් අපි ලස්සන කවියක්",
  "pg026_n0009": "ගායනා කරමු.",
  "pg027_im001": "ළමයෙක් කෑම තැටියක් අතින් ගෙන කුරුලු ලෑල්ල වෙත යයි. ගසේ කුරුල්ලෙක් සහ ලේනෙක් සිටී. ලෑල්ල අසල වතුර බඳුනක් ඇත.",
  "pg027_n0002": "කුරුලු ලෑල්ල.",
  "pg027_n0004": "වත්ත පහළ අඹ ගහ",
  "pg027_n0005": "ළඟ",
  "pg027_n0006": "හොඳට සෙවණ තිබෙන තැනක",
  "pg027_n0007": "කුරුලු ලෑල්ලක්",
  "pg027_n0008": "කදිමට",
  "pg027_n0009": "හදලා ඇත අපේ",
  "pg027_n0010": "ගෙදර",
  "pg027_n0012": "ලොකු මල්ලී එක දවසක",
  "pg027_n0013": "පොඩි මල්ලී තව දවසක",
  "pg027_n0014": "කුරුල්ලන්ට කෑම අරන්",
  "pg027_n0015": "එතනට යනවා හැම දින",
  "pg028_im002": "ගැහැණු ළමයෙක් අතේ ඉදලක් සහ බාල්දියක් ගෙන ගමන් කරයි. ඇය වනයේ ඇති මාර්ගයේ ඇවිදියි.",
  "pg028_n0003": "පසුවදාට කුරුල්ලන්ට",
  "pg028_n0004": "බඩ පිරෙන්න කෑම දෙන්න",
  "pg028_n0005": "ලෑල්ල පිරිසිදු කරන්න",
  "pg028_n0006": "මම යනවා හැන්දෑවට",
  "pg028_n0008": "ලේනුන් සහ පොල්කිච්චන්",
  "pg028_n0009": "ගිරවුන් සහ දෙමලිච්චන්",
  "pg028_n0010": "පිළිහුඩුවන් සහ කපුටන්",
  "pg028_n0011": "කෑමට එනවා උදෙන් ම",
  "pg029_im001": "කුරුලු ලෑල්ලේ ලේනුන් කෑම කති. ගසේ කඳේ ලේනෙක් නගී. වතුර බඳුනේ කුරුල්ලෝ නාති.",
  "pg029_n0002": "ලේන් හාමි කෑම",
  "pg029_n0003": "අරන්",
  "pg029_n0004": "එක පිම්මේ නගියි",
  "pg029_n0005": "ගහට",
  "pg029_n0006": "දෙමලිච්චෝ",
  "pg029_n0007": "කඩිමුඩියේ",
  "pg029_n0008": "පනිති වතුර බඳුන උඩට",
  "pg029_n0009": "උඩට",
  "pg029_n0011": "සතුන් වුණත්",
  "pg029_n0012": "එකමුතුවට",
  "pg029_n0013": "කෑම කන්නෙ",
  "pg029_n0014": "අපූරුවට",
  "pg029_n0015": "බලා ඉන්න පුංචි",
  "pg029_n0016": "අපට",
  "pg029_n0017": "සතුටක් එනෙනවා",
  "pg029_n0018": "හිතට",
  "pg030_im002": "රාත්‍රියේ අහසේ තරු ඇත. ළමයි හතරදෙනෙක් අත් ඔසවා තරු දෙස බලති. එක් ළමයෙක් ඉණිමඟේ ද, එක් ළමයෙක් ගසේ ද සිටී.",
  "pg030_n0003": "අහස",
  "pg030_n0005": "අහස උසයි හරි ම උසයි",
  "pg030_n0006": "එහි තරුමල් පිපී දිලෙයි",
  "pg030_n0007": "උඩ පැනලා තරු කඩන්න",
  "pg030_n0008": "බැරි තරමට අහස උසයි",
  "pg030_n0010": "අත දික් කරලා කඩන්න",
  "pg030_n0011": "ඉණිමඟ තියලා කඩන්න",
  "pg030_n0012": "ගස් නැගලා තරු කඩන්න",
  "pg030_n0013": "බැරි තරමට අහස උසයි",
  "pg031_im001": "රාත්‍රියේ අහසේ සඳ සහ තරු ඇත. ළමයි දෙදෙනෙක් පැදුරක් මත වැතිර සිටිති. දැරියන් දෙදෙනෙක් සඳ දෙස බලති. අසල බල්ලෙක් සහ ගසේ බකමූණෙක් සිටී.",
  "pg031_n0002": "හඳ පායා හරි ම හැඩයි",
  "pg031_n0003": "මුළු පරිසරය ම එළියයි",
  "pg031_n0004": "හඳත් අපිට අල්ලගන්න",
  "pg031_n0005": "බැරි තරමට අහස උසයි",
  "pg031_n0007": "සඳ තරු අහසේ තිබුණට",
